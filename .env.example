# ==== 依赖组件(compose ${VAR:?} 强校验,缺失拒启)====
KM_DB_PASSWORD=change-me
KM_INTERNAL_TOKEN=change-me-internal-token
# 容器端口映射(可选;本机 6379 常被 podman gvproxy 占用,redis 缺省 6380)
#   KM_API_HOST_PORT=8000
#   KM_AGENT_HOST_PORT=8001
#   KM_REDIS_HOST_PORT=6380

# ==== Agent 面(只有 LLM;ADR-002:无任何 DB 变量)====
# 端点选型目录见 docs/model-providers.md:任意 OpenAI 兼容官方端点一等公民,
# muniu/ollama 只是可选自建端点(ADR-007 修订 2026-09-26,不再强制经网关)。
# 形态一(缺省示例)= 官方直连,切家 = 改三行(主模型主机自动入白名单;
# 注册表自定义端点才需在 KM_AGENT_MODEL_ALLOWED_HOSTS 放行):
KM_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KM_AGENT_LLM_MODEL=qwen-plus
KM_AGENT_LLM_API_KEY=
# 形态二 = 经 muniu 网关(可选):key 用 muniu 签发的 mk- key,密钥收敛/统一
# 计量/多上游 failover 由网关承担(论证见 ADR-007 原决策):
#   KM_AGENT_LLM_BASE_URL=http://127.0.0.1:8787/v1
#   KM_AGENT_LLM_API_KEY=<muniu mk- key>
# 本地推理(如 ollama)同理:KM_AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# 协议声明(ADR-008):出站协议缺省 openai(Chat Completions),可声明
# anthropic(Anthropic Messages)或 responses(OpenAI Responses)。主模型级:
#   KM_AGENT_LLM_PROTOCOL=anthropic
# 注册表条目级(条目间可各不相同;分支端点目录见 docs/model-providers.md B 节):
#   {"name":"glm-coding","base_url":"<厂商 Anthropic 分支端点>","api_key":"…","model":"…","protocol":"anthropic"}
#   {"name":"qwen-rsp","base_url":"<厂商 Responses 端点>","api_key":"…","model":"…","protocol":"responses"}
# 出站韧性:瞬时故障(连接/读超时/408/429/5xx)重试 + 单层降级。
# 总尝试预算含降级目标(最坏 2×30s+退避+1×30s < 上层 120s 时限);
# 降级链=任务路由目标→主模型→显式 fallback 条目(须在注册表内;空=关闭)。
# Bot model_override 不降级(显式选择的模型与计价不容被静默替换)。
#   KM_AGENT_LLM_MAX_ATTEMPTS=3
#   KM_AGENT_LLM_RETRY_BASE_MS=500
#   KM_AGENT_LLM_RETRY_MAX_WAIT_MS=5000
#   KM_AGENT_LLM_FALLBACK_ENTRY=
# 生成提示词装配预算:送模型前校验上界,超限按段收敛(历史最旧端/证据
# 尾端首位豁免/纪律段与本轮问句不截),触发随 trace 事件下发;不可切段本身
# 超窗走可归因失败(不再假托「服务暂不可用」)。条目级 context_window 优先:
#   {"name":"qwen-long","base_url":"…","api_key":"…","model":"…","context_window":128000}
#   KM_AGENT_PROMPT_CONTEXT_WINDOW_DEFAULT=32768
#   KM_AGENT_PROMPT_RESERVED_OUTPUT_TOKENS=4096
#   KM_AGENT_PROMPT_SAFETY_MARGIN_TOKENS=1024
# 表级预筛:问题+术语/示例/指标共现加权打分收敛注入的表集合(top-N 缺省
# 12),零命中维持既有哨兵(不硬凑);关闭=全量注入逐字回退(对拍/应急):
#   KM_AGENT_SCHEMA_PRUNE=true
#   KM_AGENT_SCHEMA_PRUNE_TOP_N=12
# 问答成本控制:登录用户面分钟级速率((租户,用户) 维度)+ 租户日/月
# 按次配额(已用量=sys_llm_usage 行数,含失败尝试);公开嵌入面(助手标识,
# 客户端 IP) 维度速率。速率闸 fail-open(存储异常放行),配额闸 fail-closed
# (读数异常 503 拒绝);0=关闭该闸。默认 20/500/10000/30。
#   KM_CHAT_RATE_PER_MINUTE=20
#   KM_CHAT_QUOTA_DAILY_CALLS=500
#   KM_CHAT_QUOTA_MONTHLY_CALLS=10000
#   KM_BOT_CHAT_RATE_PER_MINUTE=30
# chat 面 SQL 执行结果行数上限(缺省 1000)
#   KM_CHAT_RESULT_MAX_ROWS=1000
# SQL 安全引擎模式:builtin | shadow | primary;缺省 shadow(内置路径
# 内置路径生效，并行比较只记录结果。切换主引擎前按 docs/HANDOFF.md 的步骤验收:
#   KM_SQLGUARD_MODE=shadow      (api 面)
#   KM_AGENT_SQLGUARD_MODE=shadow (agent 面)
# embedding 独立配置:缺省回退 LLM_* 组——主模型切非通义供应商时
# embeddings API 不存在会使 RAG 检索降级，因此需单独配置 DashScope 凭证。
# Qwen3.7 文本向量需设置 dimensions=2560；向量列使用 halfvec(2560)，
# 四类向量列 halfvec(2560);北京区域每批上限 20(agent 内部分批)
# KM_AGENT_EMBEDDING_API_KEY=
# KM_AGENT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KM_AGENT_EMBEDDING_MODEL=qwen3.7-text-embedding

# ==== 控制面:GitHub 联邦(可选)====
# GitHub → Settings → Developer settings → OAuth Apps 注册后填入
# Authorization callback URL 填:http://localhost:5173/auth/github/callback(与代码精确一致)
KM_GITHUB_CLIENT_ID=
KM_GITHUB_CLIENT_SECRET=
# 生产环境覆盖回调地址(须同步更新 GitHub OAuth App 的 callback 配置)
# KM_GITHUB_REDIRECT_URI=

# ==== 控制面:Google 联邦(可选,ADR-006)====
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID(Web)
# Authorized redirect URI 填:http://localhost:5173/auth/google/callback
KM_GOOGLE_CLIENT_ID=
KM_GOOGLE_CLIENT_SECRET=
# KM_GOOGLE_REDIRECT_URI=

# ==== 控制面:虎符(hufu)统一身份联邦(可选,标准 OIDC)====
# 虎符 issuer 必须与发现文档逐字一致;回调地址需在虎符 client 登记。
# 本地回调:http://localhost:5173/auth/hufu/callback
KM_HUFU_ENABLED=true
KM_HUFU_ISSUER=
KM_HUFU_CLIENT_ID=
KM_HUFU_CLIENT_SECRET=
# KM_HUFU_REDIRECT_URI=http://localhost:5173/auth/hufu/callback

# ==== 控制面:企业微信联邦(可选)====
# 企业微信管理后台 → 应用管理 → 自建应用:Secret 在应用详情,AgentId 同页;
# 企业 ID(corpid)在「我的企业 → 企业信息」页底。
# 应用「网页授权及 JS-SDK」可信域名/回调域填 web 域名;
# 本地回调:http://localhost:5173/auth/wecom/callback
# 取用户昵称/头像需应用具备通讯录查看权限,无权限时降级以 UserId 作显示名(登录不受阻)
KM_WECOM_CORPID=
KM_WECOM_SECRET=
KM_WECOM_AGENTID=
# KM_WECOM_REDIRECT_URI=

# ==== 控制面:钉钉联邦(可选)====
# 钉钉开放平台 → 应用开发 → 企业内部应用 → 凭证与基础信息:Client ID/Secret;
# 「安全设置」回调域名填 web 域名;需开通「通讯录个人信息读权限」
# 本地回调:http://localhost:5173/auth/dingtalk/callback
KM_DINGTALK_CLIENT_ID=
KM_DINGTALK_CLIENT_SECRET=
# KM_DINGTALK_REDIRECT_URI=

# ==== 控制面:飞书联邦(可选)====
# 飞书开放平台 → 开发者后台 → 企业自建应用 → 凭证与基础信息:App ID/App Secret;
# 「安全设置 → 重定向 URL」填:http://localhost:5173/auth/feishu/callback
KM_FEISHU_APP_ID=
KM_FEISHU_APP_SECRET=
# KM_FEISHU_REDIRECT_URI=

# ==== 联邦总开关(可选,默认全开)====
# 任一置 false 即临时停用该家(凭证保留,前端入口隐藏,start/callback 404);
# 典型场景:企微在正式域名/可信 IP 就绪前关停
# KM_GITHUB_ENABLED=true
# KM_GOOGLE_ENABLED=true
# KM_WECOM_ENABLED=true
# KM_DINGTALK_ENABLED=true
# KM_FEISHU_ENABLED=true

# ==== 控制面:启动种子超管(rbac spec「种子数据」)====
# 缺省(留空)时超管密码为不安全默认值 admin123 并强制首登改密
KM_ADMIN_USERNAME=admin
KM_ADMIN_INITIAL_PASSWORD=

# ==== 控制面:数据源密码加密(prod 必填,dev 缺省使用固定 dev-only 密钥)====
# base64 编码的 16/32 字节(AES-128/256-GCM);生成方法:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 轮换密钥后存量密文不可解(需逐数据源「编辑重填密码」修复),请妥善保管
KM_DATASOURCE_ENCRYPT_KEY=

# ==== 控制面:结果导出(可选)====
# 导出行数截断上限(默认 10000,防服务端内存失控)
# KM_EXPORT_MAX_ROWS=10000

# prod 专用(KM_ENVIRONMENT=prod 时 fail-closed 强校验)
# KM_JWT_PRIVATE_KEY_PEM=
# KM_JWT_PUBLIC_KEY_PEM=

# ==== 控制面:代码沙箱(默认关闭,需显式开启)====
# 开启需宿主 podman 可用且已构建镜像:
#   podman build -f infra/sandbox.Dockerfile -t kongming-sandbox:dev infra/
# KM_SANDBOX_ENABLED=false
# KM_SANDBOX_IMAGE=kongming-sandbox:dev
# KM_SANDBOX_TIMEOUT_SEC=30
# KM_SANDBOX_MEM_MB=256
# KM_SANDBOX_CPUS=0.5

# ==== 控制面:MCP 出站(可选)====
# KM_MCP_OUTBOUND_TIMEOUT_SEC=15
# MCP 运行时请求连续超时或连接失败达到阈值后，会在冷却期内快速失败；冷却期满后尝试恢复。
# 管理面探测、同步和模板预览不受熔断影响；协议、远端和不支持等确定性错误不计入失败次数。
# 同步成功后会重置失败次数。默认阈值为 3 次/60 秒；设为 false 可关闭熔断。
# KM_MCP_BREAKER_ENABLED=true
# KM_MCP_BREAKER_THRESHOLD=3
# KM_MCP_BREAKER_COOLDOWN_SEC=60

# ==== 答案异步评分(可选)====
# SUCCESS 问答轮终态落库后,经 agent 面评审模型做主张分解,控制面按确定性
# 公式重算分数入库并在质量台展示。设为 false 关闭(逐字回到无评分行为);
# 评审是长输出(主张分解),超时独立于标题改写等短任务。
# KM_ANSWER_SCORING_ENABLED=true
# KM_ANSWER_SCORING_TIMEOUT_SEC=90

# ==== 控制面:mock 支付通道(可选)====
# mock 是 v1 唯一收款路径(默认开);密钥 dev 占位,生产必须显式替换
# KM_BILLING_MOCK_ENABLED=true
# KM_BILLING_MOCK_SECRET=dev-mock-payment-secret
# KM_BILLING_PAYMENT_TTL_MINUTES=30

# ==== 控制面:成本对账旁路(可选,只读)====
# 牌价账单与 muniu credit 成本的量级核对;token 缺省空 = 对账端点
# 报告「未配置」。纯对账旁路,不配不影响任何计费行为。
# KM_MUNIU_ADMIN_BASE_URL=http://127.0.0.1:8787
# KM_MUNIU_ADMIN_TOKEN=
# KM_COST_RECONCILE_THRESHOLD=0.2

# ── 连接池参数(缺省值保持当前行为)────────────────────────
# pool_pre_ping 恒开(检出前存活校验);以下三项可配:
# KM_DB_POOL_SIZE=5
# KM_DB_MAX_OVERFLOW=5
# KM_DB_POOL_RECYCLE_SEC=0   # 0=不换代;>0 为连接最大存活秒

# ──  运行日志 ───────────────────────────────────────────────
# KM_LOG_LEVEL=INFO
# KM_AGENT_LOG_LEVEL=INFO

# ── 联网检索(可选)──────────────────────
# 供应商+API key 齐备才注册 web_search 工具(显式授予 tool:websearch:search);
# 未配置时不注册 web_search 工具。供应商值:tavily | bocha | zhipu(智谱独立检索 API,
# 复用 bigmodel key 零额外注册)。组合残缺(供应商缺 key、
# 仅配 key 缺供应商、供应商非法值):prod 拒启(fail-closed)、dev 告警降级。
# 凭证只进控制面,agent 面零感知。
# KM_WEBSEARCH_PROVIDER=
# KM_WEBSEARCH_API_KEY=
# KM_WEBSEARCH_TIMEOUT_MS=8000
# KM_TOOLGATEWAY_WEBSEARCH_QUOTA=20

# ── 文档检索精排(可选)──────────────────────
# provider+key+model 齐备才启用精排级(RRF 融合后候选池扩量重排,降级
# RRF-only 不阻断);均未配置=精排级零存在感。组合残缺(配 provider 缺
# key/model、缺 provider 只配 key/model):prod 拒启(fail-closed)、dev
# 告警降级;provider 非法值 dev/prod 同拒启。凭证只进控制面,agent 面零感知。
# 供应商值域:siliconflow(例 BAAI/bge-reranker-v2-m3)| bailian(例 gte-rerank-v2)
# KM_RERANK_PROVIDER=
# KM_RERANK_API_KEY=
# KM_RERANK_MODEL=
# KM_RERANK_POOL_TOPK=20
# KM_RERANK_SCORE_THRESHOLD=0
# KM_RERANK_TIMEOUT_MS=3000

# ── 全文检索分词(可选;缺省 simple)──────────────────
# 表说明和文档全文检索共用 PG 分词配置(部署级单值,写读同源;
# 值域 simple | zhparser)。白名单外值与目标库 pg_ts_config 缺失(如 zhparser
# 扩展未装)一律拒启(dev/prod 同,无降级形态)。启用配方(扩展安装 →
# 重扫重算 tsv → 全文路阈值复标)见 docs/HANDOFF.md
# 「中文分词(zhparser)启用配方」。
# KM_RAG_FULLTEXT_TS_CONFIG=simple

# ==== 调优参数(均有缺省值;需要时取消注释)====
# ── 运行环境与认证(ADR-003)────────────────────────────
# prod 下密钥/凭证类配置缺失即拒启;dev 缺省不校验
# KM_ENVIRONMENT=dev
# KM_JWT_ISSUER=kongming
# KM_ACCESS_TOKEN_TTL_SEC=900
# KM_REFRESH_TOKEN_TTL_SEC=604800
# KM_AUTH_LOGIN_MAX_FAILS=5
# KM_AUTH_LOGIN_LOCK_MIN=15
# KM_AUTH_STATE_TTL_SEC=600

# ── api 侧 agent 超时与任务预算 ────────────────────────
# 任务传输超时须覆盖任务墙钟预算(900s)+ 余量;预算天花板在创建/声明时钳制
# KM_AGENT_TIMEOUT_SEC=120
# KM_AGENT_REPORT_TIMEOUT_SEC=600
# KM_AGENT_TASK_TIMEOUT_SEC=960
# KM_TASK_BUDGET_MAX_STEPS=12
# KM_TASK_BUDGET_MAX_TOKENS=200000
# KM_TASK_BUDGET_MAX_SECONDS=900
# KM_GRAPH_CONFIRM_TTL_MINUTES=30
# KM_COLLAB_MAX_WORKERS=3
# KM_COLLAB_MAX_ROUNDS=3

# ── 在途任务看门狗 ─────────────────────────────────────
# 停滞阈值须显著小于任务预算,保证先于传输层超时收口
# KM_WATCHDOG_ENABLED=true
# KM_WATCHDOG_INTERVAL_SEC=60
# KM_WATCHDOG_STALE_SEC=300
# KM_WATCHDOG_JUDGE_TIMEOUT_SEC=20

# ── 检索相关度闸门与上传上限 ──────────────────────────
# 全文门槛尚未标定,缺省 0(不裁全文结果);向量门槛按评测标定
# KM_RAG_GATE_VECTOR_TOP1=0.30
# KM_RAG_GATE_VECTOR_MEAN=0.28
# KM_RAG_GATE_FULLTEXT_TOP1=0
# KM_RAG_GATE_FULLTEXT_MEAN=0
# KM_RAG_GATE_MIN_COUNT=1
# KM_RAG_GATE_MEAN_WINDOW=3
# 文本类 1MB / PDF·Word 10MB 分档;embedding 维度须与模型一致
# KM_RAG_TEXT_UPLOAD_MAX_BYTES=1048576
# KM_RAG_BINARY_UPLOAD_MAX_BYTES=10485760
# KM_RAG_EMBEDDING_DIM=2560
# 按已登记表关系补一跳关联表;0=不扩展
# KM_RAG_EXPAND_ENABLED=true
# KM_RAG_EXPAND_MAX=2

# ── 文档实体抽取/检索扩展(缺省关;启用须端点+key+model 齐备)──
# 私网/本机端点需显式豁免
# KM_DOC_ENTITY_ENABLED=false
# KM_DOC_ENTITY_LLM_BASE_URL=
# KM_DOC_ENTITY_LLM_API_KEY=
# KM_DOC_ENTITY_LLM_MODEL=
# KM_DOC_ENTITY_TIMEOUT_MS=8000
# KM_DOC_ENTITY_QUERY_MAX=8
# KM_DOC_ENTITY_ALLOW_PRIVATE_LLM=false
# 子块按句界校准(缺省关:切分与既有实现逐字一致)
# KM_DOC_CHUNK_SENTENCE_BOUNDARY=false

# ── 审计、商店与工具网关 ─────────────────────────────
# 库内热数据窗口(天)与归档目录(随部署备份)
# KM_AUDIT_ARCHIVE_DAYS=180
# KM_AUDIT_ARCHIVE_DIR=var/audit-archive
# 商店封顶淘汰只淘汰最旧的「非当前」版本
# KM_BOT_STORE_VERSION_CAP=10
# 租户 schema 内省表数上限(防 prompt 膨胀)
# KM_META_SCHEMA_MAX_TABLES=50
# 工具执行限流(次/分钟,租户+用户)与写工具确认窗口(分钟)
# KM_TOOL_RATE_LIMIT_PER_MINUTE=60
# KM_TOOL_CONFIRM_TTL_MINUTES=15
# 触发器失败重试的部署级固定间隔(次数上限在触发器表配置)
# KM_TRIGGER_RETRY_BACKOFF_SEC=60
# 租户 HTTP 连接器配额与注册超时上限
# KM_TOOLGATEWAY_HTTP_QUOTA=20
# KM_CONNECTOR_TIMEOUT_MAX_MS=15000

# ── 语音转写 ─────────────────────────────────────────
# faster-whisper 模型规格;模型文件在位即启用,缺失时 /chat/stt 返回 503
# KM_STT_MODEL=small
