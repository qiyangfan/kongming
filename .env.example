# ==== 基础设施(compose ${VAR:?} 强校验,缺失拒启)====
KM_DB_PASSWORD=change-me
KM_INTERNAL_TOKEN=change-me-internal-token

# ==== Agent 面(只有 LLM;ADR-002:无任何 DB 变量)====
# 端点选型目录见 docs/model-providers.md:任意 OpenAI 兼容官方端点一等公民,
# muniu/ollama 只是可选自建端点(ADR-007 修订 2026-09-26,不再强制经网关)。
# 形态一(缺省示例)= 官方直连,切家 = 改三行(主模型主机自动入白名单;
# 注册表自定义端点才需在 KM_AGENT_MODEL_ALLOWED_HOSTS 放行):
KM_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KM_AGENT_LLM_MODEL=qwen-plus
KM_AGENT_LLM_API_KEY=
# 形态二 = 经 muniu 网关(可选):key 用 muniu 签发的 mk- key,密钥收敛/统一
# 计量/多上游 failover 由网关承担(论证见 ADR-007 原决策):
#   KM_AGENT_LLM_BASE_URL=http://127.0.0.1:8787/v1
#   KM_AGENT_LLM_API_KEY=<muniu mk- key>
# 本地推理(如 ollama)同理:KM_AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# 协议声明(ADR-008):出站协议缺省 openai(Chat Completions),可声明
# anthropic(Anthropic Messages)或 responses(OpenAI Responses)。主模型级:
#   KM_AGENT_LLM_PROTOCOL=anthropic
# 注册表条目级(条目间可各不相同;分支端点目录见 docs/model-providers.md B 节):
#   {"name":"glm-coding","base_url":"<厂商 Anthropic 分支端点>","api_key":"…","model":"…","protocol":"anthropic"}
#   {"name":"qwen-rsp","base_url":"<厂商 Responses 端点>","api_key":"…","model":"…","protocol":"responses"}
# SQL 安全引擎模式(053):builtin | shadow | primary;缺省 shadow(内置路径
# 权威,引擎并行对拍只记录不生效)。切主条件见 HANDOFF 053 归档门:
#   KM_SQLGUARD_MODE=shadow      (api 面)
#   KM_AGENT_SQLGUARD_MODE=shadow (agent 面)
# embedding 独立配置(009):缺省回退 LLM_* 组——主模型切非通义供应商时
# embeddings API 不存在会致 RAG 静默降级,固定走 dashscope(上游 028 教训)
# KM_AGENT_EMBEDDING_API_KEY=
# KM_AGENT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KM_AGENT_EMBEDDING_MODEL=text-embedding-v2

# ==== 控制面:GitHub 联邦(可选)====
# GitHub → Settings → Developer settings → OAuth Apps 注册后填入
# Authorization callback URL 填:http://localhost:5173/auth/github/callback(与代码精确一致)
KM_GITHUB_CLIENT_ID=
KM_GITHUB_CLIENT_SECRET=
# 生产环境覆盖回调地址(须同步更新 GitHub OAuth App 的 callback 配置)
# KM_GITHUB_REDIRECT_URI=

# ==== 控制面:Google 联邦(可选,ADR-006)====
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID(Web)
# Authorized redirect URI 填:http://localhost:5173/auth/google/callback
KM_GOOGLE_CLIENT_ID=
KM_GOOGLE_CLIENT_SECRET=
# KM_GOOGLE_REDIRECT_URI=

# ==== 控制面:企业微信联邦(可选,003)====
# 企业微信管理后台 → 应用管理 → 自建应用:Secret 在应用详情,AgentId 同页;
# 企业 ID(corpid)在「我的企业 → 企业信息」页底。
# 应用「网页授权及 JS-SDK」可信域名/回调域填 web 域名;
# 本地回调:http://localhost:5173/auth/wecom/callback
# 取用户昵称/头像需应用具备通讯录查看权限,无权限时降级以 UserId 作显示名(登录不受阻)
KM_WECOM_CORPID=
KM_WECOM_SECRET=
KM_WECOM_AGENTID=
# KM_WECOM_REDIRECT_URI=

# ==== 控制面:钉钉联邦(可选,003)====
# 钉钉开放平台 → 应用开发 → 企业内部应用 → 凭证与基础信息:Client ID/Secret;
# 「安全设置」回调域名填 web 域名;需开通「通讯录个人信息读权限」
# 本地回调:http://localhost:5173/auth/dingtalk/callback
KM_DINGTALK_CLIENT_ID=
KM_DINGTALK_CLIENT_SECRET=
# KM_DINGTALK_REDIRECT_URI=

# ==== 控制面:飞书联邦(可选,003)====
# 飞书开放平台 → 开发者后台 → 企业自建应用 → 凭证与基础信息:App ID/App Secret;
# 「安全设置 → 重定向 URL」填:http://localhost:5173/auth/feishu/callback
KM_FEISHU_APP_ID=
KM_FEISHU_APP_SECRET=
# KM_FEISHU_REDIRECT_URI=

# ==== 联邦总开关(可选,默认全开)====
# 任一置 false 即临时停用该家(凭证保留,前端入口隐藏,start/callback 404);
# 典型场景:企微在正式域名/可信 IP 就绪前关停
# KM_GITHUB_ENABLED=true
# KM_GOOGLE_ENABLED=true
# KM_WECOM_ENABLED=true
# KM_DINGTALK_ENABLED=true
# KM_FEISHU_ENABLED=true

# ==== 控制面:启动种子超管(rbac spec「种子数据」)====
# 缺省(留空)时超管密码为不安全默认值 admin123 并强制首登改密
KM_ADMIN_USERNAME=admin
KM_ADMIN_INITIAL_PASSWORD=

# ==== 控制面:数据源密码加密(008;prod 必填,dev 缺省降级为固定 dev-only 密钥)====
# base64 编码的 16/32 字节(AES-128/256-GCM);生成方法:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 轮换密钥后存量密文不可解(需逐数据源「编辑重填密码」修复),请妥善保管
KM_DATASOURCE_ENCRYPT_KEY=

# ==== 控制面:结果导出(010;可选)====
# 导出行数截断上限(默认 10000,防服务端内存失控)
# KM_EXPORT_MAX_ROWS=10000

# prod 专用(KM_ENVIRONMENT=prod 时 fail-closed 强校验)
# KM_JWT_PRIVATE_KEY_PEM=
# KM_JWT_PUBLIC_KEY_PEM=

# ==== 控制面:代码沙箱(027;默认关闭,显式开启)====
# 开启需宿主 podman 可用且已构建镜像:
#   podman build -f infra/sandbox.Dockerfile -t kongming-sandbox:dev infra/
# KM_SANDBOX_ENABLED=false
# KM_SANDBOX_IMAGE=kongming-sandbox:dev
# KM_SANDBOX_TIMEOUT_SEC=30
# KM_SANDBOX_MEM_MB=256
# KM_SANDBOX_CPUS=0.5

# ==== 控制面:MCP 出站(028;可选)====
# KM_MCP_OUTBOUND_TIMEOUT_SEC=15

# ==== 控制面:mock 支付通道(035;可选)====
# mock 是 v1 唯一收款路径(默认开);密钥 dev 占位,生产必须显式替换
# KM_BILLING_MOCK_ENABLED=true
# KM_BILLING_MOCK_SECRET=dev-mock-payment-secret
# KM_BILLING_PAYMENT_TTL_MINUTES=30

# ==== 控制面:成本对账旁路(055;可选,只读)====
# 牌价账单与 muniu credit 成本的量级核对;token 缺省空 = 对账端点
# 报告「未配置」。纯对账旁路,不配不影响任何计费行为。
# KM_MUNIU_ADMIN_BASE_URL=http://127.0.0.1:8787
# KM_MUNIU_ADMIN_TOKEN=
# KM_COST_RECONCILE_THRESHOLD=0.2
