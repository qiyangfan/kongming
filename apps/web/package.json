{
  "name": "kongming-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test:run": "vitest run",
    "contracts:gen": "openapi-typescript ../../contracts/openapi.json --output ../../packages/api-client/src/api-types.gen.ts && node scripts/gen-sse-validator.mjs",
    "e2e": "playwright test",
    "size": "size-limit",
    "preview": "vite preview",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.0.0",
    "tw-animate-css": "^1.4.0",
    "@kongming/ui": "workspace:*",
    "@kongming/api-client": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "8.20.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^27.4.0",
    "knip": "^6.48.0",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.154.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "refractor": "^5.0.0"
  },
  "size-limit": [
    {
      "name": "total js (gzip)",
      "path": "dist/assets/*.js",
      "limit": "800 kB"
    },
    {
      "name": "echarts chunk",
      "path": "dist/assets/chart-view-impl-*.js",
      "limit": "210 kB"
    },
    {
      "name": "react vendor chunk",
      "path": "dist/assets/react-vendor-*.js",
      "limit": "110 kB"
    }
  ]
}
